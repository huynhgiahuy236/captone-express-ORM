        {
          "name": "2.4 Create Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && (jsonData.data.hinh_id || jsonData.data.id)) {",
                  "    const id = jsonData.data.hinh_id || jsonData.data.id;",
                  "    pm.environment.set('createdImageId', id);",
                  "    pm.collectionVariables.set('createdImageId', id);",
                  "    console.log('Created Image ID saved:', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Siêu phẩm siêu xe Ferrari",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Bức ảnh xe thể thao đẳng cấp thế giới",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Xe cộ",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images"
              ]
            }
          }
        },
        {
